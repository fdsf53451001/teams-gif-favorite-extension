{
  "manifest_version": 3,
  "name": "Teams GIF 我的最愛",
  "version": "0.1.2",
  "description": "在 Microsoft Teams 網頁版加入 GIF 我的最愛功能，類似 Discord 的收藏體驗",
  "permissions": ["storage"],
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.giphy.com/*",
    "https://*.tenor.com/*",
    "https://*.tenor.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "src/content/selectors.js",
        "src/content/favorites-store.js",
        "src/content/gif-inserter.js",
        "src/content/chat-watcher.js",
        "src/content/picker-watcher.js",
        "src/content/content.js"
      ],
      "css": ["src/content/styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "icons": {
    "16": "src/icons/icon-16.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  }
}
